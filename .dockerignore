# Git
.git
.gitignore
.gitmodules

# Python
__pycache__
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
!scripts/build/
!scripts/build/**

# Virtual environments
venv/
env/
ENV/

# Dependencies
node_modules
**/node_modules
.venv
**/.venv
.notebooklm-cli-venv/
.notebooklm-playwright/
.pip-cache/
.uv-cache/
.cache/
.build/

# Built artifacts that are regenerated inside the image.  Excluded so local
# rebuilds on the developer's machine don't invalidate the npm-install layer
# that now depends on the full ui-tui/packages/phi-ink/ tree being present.
ui-tui/dist/
ui-tui/packages/phi-ink/dist/

# CI/CD
.github

# Environment files
.env
.env.*
# ...but keep the template: docker/stage2-hook.sh seeds $PHI_HOME/.env from
# /opt/phi/.env.example on first boot (OOF-285 — excluding it silently broke
# first-boot .env seeding and the API_SERVER_KEY generation that depends on it).
!.env.example

# IDE
.vscode/
.idea/
*.swp
*.swo

# Testing
.pytest_cache/
.coverage
htmlcov/

# Documentation
*.md
!skills/**/*.md
!optional-skills/**/*.md

# Runtime data (bind-mounted at /opt/data; must not leak into build context)
data/
.phi-docker/
.notebooklm-home/

# Compose/profile runtime state (bind-mounted; avoid ownership/secret issues)
phi-config/
runtime/

# ---------- Not needed inside the Docker image ----------

# Desktop app source (Tauri/Electron); never installed in the container.
# apps/shared is the dashboard↔desktop websocket helper and is linked from
# web/package.json as a file: workspace dep — keep it in the build context.
apps/
!apps/shared/
!apps/shared/**

# Test suite — not shipped in production images
tests/

# Documentation site (Docusaurus)
website/
docs/

# Brand artwork is not an image-build input (PHI ships committed icons under web/public).
assets/
infographic/

# Plugin-level docs (phi-achievements ships docs/ but the runtime doesn't read them)
plugins/phi-achievements/docs/

# Nix / Homebrew / AUR packaging metadata — irrelevant to Docker
nix/
flake.nix
flake.lock
packaging/

# Design and planning documents
plans/
.plans/
.phi/

# Repo-level dotfiles that are git-only or dev-tooling config
.envrc
.gitattributes
.hadolint.yaml
.mailmap

# Debug/export artifacts — must never reach image layers (COPY . .)
/log.txt
/sqlite_leak_fix.png
/*.png.bak
*.tar.gz
*.tgz
