#!/usr/bin/env bash
# ============================================================================
# venv-style activation of the Phi dev environment for an interactive shell.
#
#   source ./activate       (bash / zsh, repo root)
#   source ./activate.fish  (fish)
#   .\activate.ps1          (PowerShell)
#
# Applies the composed pm env (PATH + tool vars) to the CURRENT shell, with
# save/restore: `deactivate` undoes exactly what activation changed.
#
# `phi` becomes a shell function for this checkout. It runs only while the
# shell is inside this worktree and refuses outside it, so a sibling worktree
# keeps its own command. A prompt prefix names the worktree.
#
# Scripts and other processes do not source this: they run under
# `scripts/run-in-phi-env`. Both build on scripts/_activation.sh.
#
# Sync through setup before selecting the environment. PM owns freshness;
# activation does not maintain a second dependency stamp. It trusts the
# recorded tool digest instead of re-hashing every entry. `phi pm
# install` and `phi update` keep that check.
# ============================================================================
_PHI_REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Options: `--test-extras a,b` selects the test environment's runtime extras
# (default: [all]); `--` ends options.
# A bare `source ./activate` inherits the caller's positional parameters.
# Ignore unrelated words so scripts with their own arguments can source it.
_phi_test_env="--test-environment"
_phi_expect_extras=""
for _phi_arg in "$@"; do
    if [ -n "$_phi_expect_extras" ]; then
        _phi_test_env="--test-environment=$_phi_arg"
        _phi_expect_extras=""
        continue
    fi
    case "$_phi_arg" in
        --) break ;;
        --test-extras) _phi_expect_extras=1 ;;
        --test-extras=*) _phi_test_env="--test-environment=${_phi_arg#--test-extras=}" ;;
        *) : ;;
    esac
done
if [ -n "$_phi_expect_extras" ]; then
    printf '%s\n' 'activate: --test-extras needs a comma-separated list' >&2
    unset _phi_arg _phi_test_env _phi_expect_extras
    return 2 2>/dev/null || exit 2
fi
unset _phi_arg _phi_expect_extras

# shellcheck source=scripts/_activation.sh
. "$_PHI_REPO/scripts/_activation.sh"

if ! phi_sync "$_PHI_REPO" "$_phi_test_env"; then
    printf '%s\n' 'activate: setup failed; shell environment unchanged' >&2
    unset _phi_test_env
    return 1 2>/dev/null || exit 1
fi
unset _phi_test_env

# Guard against double-sourcing: venv activate precedent (re-activating is a
# no-op re-save; we keep it idempotent by deactivating first). Key on the
# function, not the sentinel: child shells inherit __PHI_ACTIVATED from an
# activated parent but never the function, and there is nothing to undo there.
if [ "$(type -t deactivate 2>/dev/null)" = "function" ]; then
    deactivate
fi

_phi_script="$(phi_compose_env "$_PHI_REPO" sh)" || {
    echo "activate: could not compose the environment (see above)" >&2
    unset _phi_script
    return 1 2>/dev/null || exit 1
}
_phi_keys="$(printf '%s\n' "$_phi_script" | sed -n 's/^export \([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p' | tr '\n' ' ')"

# --- snapshot what we are about to change (deactivate restores this) ---
# __PHI_ACTIVATED is part of the composed env below (it carries the
# installed-state path this environment was built from), so it is snapshotted
# and exported with every other key — no separate assignment here.
__PHI_SAVED_PATH="$PATH"
for _phi_k in $_phi_keys; do
    eval "__PHI_SAVED_$_phi_k=\"\${$_phi_k+set}\""
    eval "__PHI_PRIOR_$_phi_k=\${$_phi_k-__PHI_UNSET__}"
done
phi_apply_env "$_phi_script"

# This checkout, not whichever `phi` PATH finds. A function beats PATH, an
# alias, and a hashed command, including the MSIX execution alias.
__PHI_WORKTREE="$_PHI_REPO"
# The branch names the worktree. A checkout cannot share a branch with another.
__PHI_WORKTREE_NAME="$(git -C "$_PHI_REPO" rev-parse --abbrev-ref HEAD 2>/dev/null || :)"
if [ -z "$__PHI_WORKTREE_NAME" ] || [ "$__PHI_WORKTREE_NAME" = HEAD ]; then
    __PHI_WORKTREE_NAME="$(basename "$_PHI_REPO")"
fi
__PHI_SAVED_PS1="${PS1-__PHI_UNSET__}"
__PHI_SAVED_PROMPT_COMMAND="${PROMPT_COMMAND-__PHI_UNSET__}"

_phi_worktree_here() {
    _phi_top="$(git rev-parse --show-toplevel 2>/dev/null)" || return 1
    [ "$(cd "$_phi_top" && pwd -P)" = "$(cd "$__PHI_WORKTREE" && pwd -P)" ]
}

phi() {
    _phi_worktree_here || {
        printf '%s\n' "phi: $(pwd) is outside $__PHI_WORKTREE; refusing (the installed command is hidden while this checkout is active)" >&2
        return 1
    }
    (
        cd "$__PHI_WORKTREE" || exit 1
        if [ -n "${PYTHON-}" ]; then
            exec "$PYTHON" phi "$@"
        elif [ -x .venv/Scripts/python.exe ]; then
            exec .venv/Scripts/python.exe phi "$@"
        elif [ -x .venv/bin/python ]; then
            exec .venv/bin/python phi "$@"
        elif [ -x venv/Scripts/python.exe ]; then
            exec venv/Scripts/python.exe phi "$@"
        elif [ -x venv/bin/python ]; then
            exec venv/bin/python phi "$@"
        else
            exec python phi "$@"
        fi
    )
}

_phi_prompt() {
    if [ "$__PHI_SAVED_PS1" = "__PHI_UNSET__" ]; then
        _phi_base_ps1=""
    else
        _phi_base_ps1="$__PHI_SAVED_PS1"
    fi
    if _phi_worktree_here; then
        PS1="($__PHI_WORKTREE_NAME) $_phi_base_ps1"
    else
        PS1="$_phi_base_ps1"
    fi
}

if [ -n "${PROMPT_COMMAND-}" ]; then
    PROMPT_COMMAND="_phi_prompt; ${PROMPT_COMMAND}"
else
    PROMPT_COMMAND=_phi_prompt
fi
_phi_prompt

deactivate() {
    export PATH="$__PHI_SAVED_PATH"
    for _phi_k in $__PHI_KEY_LIST; do
        eval "_phi_was=\"\$__PHI_SAVED_$_phi_k\""
        eval "_phi_old=\"\$__PHI_PRIOR_$_phi_k\""
        if [ "$_phi_was" != "set" ]; then
            unset "$_phi_k"
        else
            export "$_phi_k=$_phi_old"
        fi
        unset "__PHI_SAVED_$_phi_k" "__PHI_PRIOR_$_phi_k"
    done
    if [ "$__PHI_SAVED_PS1" = "__PHI_UNSET__" ]; then
        unset PS1
    else
        PS1="$__PHI_SAVED_PS1"
    fi
    if [ "$__PHI_SAVED_PROMPT_COMMAND" = "__PHI_UNSET__" ]; then
        unset PROMPT_COMMAND
    else
        PROMPT_COMMAND="$__PHI_SAVED_PROMPT_COMMAND"
    fi
    unset __PHI_SAVED_PATH __PHI_KEY_LIST __PHI_ACTIVATED \
          __PHI_WORKTREE __PHI_WORKTREE_NAME \
          __PHI_SAVED_PS1 __PHI_SAVED_PROMPT_COMMAND
    unset -f deactivate phi _phi_worktree_here _phi_prompt
    unset _phi_k _phi_was _phi_old _phi_top
}

# remember the key list for deactivate (kept out of the loop vars above)
__PHI_KEY_LIST="$_phi_keys"

# The composition library is not part of the user's shell.
unset -f phi_sync phi_bootstrap_python phi_compose_env phi_apply_env \
         phi_activation_current phi_ensure_env
unset _PHI_REPO _phi_script _phi_keys _phi_k _phi_top
